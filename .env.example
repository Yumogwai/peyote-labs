# Required for chat agent
# Set these in Vercel Project Settings → Environment Variables
# (Production, Preview, Development)

# Neon PostgreSQL (auto-added by Vercel Neon integration)
DATABASE_URL=

# Google Gemini Developer API
GEMINI_API_KEY=

# Feature flag to disable chat instantly
CHAT_ENABLED=true

# Optional: override defaults
# CHAT_RATE_LIMIT_PER_HOUR=20
# CHAT_MONTHLY_BUDGET_USD=10
# CHAT_BUDGET_ALERT_USD=8